#!/usr/bin/env bash
# The test gate (development#1239), then the global pre-commit (gitleaks).
TEST_GATE_NODE=/opt/homebrew/opt/node@24/bin/node; [ -x "$TEST_GATE_NODE" ] || TEST_GATE_NODE=node; if command -v "$TEST_GATE_NODE" >/dev/null 2>&1 && "$TEST_GATE_NODE" -e 'process.exit(process.features.typescript ? 0 : 1)'; then "$TEST_GATE_NODE" _githooks/test-gate.ts --staged || exit $?; export TEST_GATE_DONE=1; else echo "test-gate: Node 23.6+ not found, skipped (CI still runs the gate)" >&2; fi
GLOBAL_HOOK="$HOME/.config/git/hooks/pre-commit"
if [ -x "$GLOBAL_HOOK" ]; then
  "$GLOBAL_HOOK" "$@" || exit $?
fi
